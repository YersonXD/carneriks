rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity verification path
    match /test/{docId} {
      allow read: if true;
    }

    // Menú de platos de Carneriks
    match /dishes/{dishId} {
      allow read, write: if true;
    }

    // Comandas en tiempo real de Carneriks (envío y cocina)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Mesas del restaurante en tiempo real
    match /tables/{tableId} {
      allow read, write: if true;
    }
  }
}
